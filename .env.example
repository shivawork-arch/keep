# MongoDB
MONGO_ROOT_USER=keep_admin
MONGO_ROOT_PASSWORD=change_me_mongo
MONGO_URI=mongodb://keep_admin:change_me_mongo@localhost:27017

# Neo4j (NEO4J_USER is conventionally "neo4j")
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j

# Ollama
OLLAMA_URL=http://localhost:11434

# n8n base address. GitHub reaches FastAPI, not n8n, so this stays local. Must end with /
N8N_WEBHOOK_URL=http://localhost:5678/

# GitHub webhook secret (same value as in the repo's webhook settings)
GITHUB_WEBHOOK_SECRET=change_me_64_hex_chars

# Vector score floor for PR Review and Pre-Mortem (tuned with backend/tune_cutoff.py)
REVIEW_MIN_SCORE=0.80
